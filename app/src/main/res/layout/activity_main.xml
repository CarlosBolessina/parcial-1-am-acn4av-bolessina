<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F1F5F9"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Mi Composición Musical"
                android:textSize="28sp"
                android:textColor="#172554"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgMusica"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:src="@drawable/musica"
                android:contentDescription="Imagen relacionada con composición musical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:text="Nuevo proyecto de composición"
                android:textSize="20sp"
                android:textColor="#334155"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Nombre del proyecto"
                android:textColor="#334155"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:backgroundTint="#94A3B8"
                android:textColor="#334155"
                android:hint="Escribí un nombre" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Género musical"
                android:textColor="#334155"
                android:textSize="18sp" />

            <Spinner
                android:id="@+id/spinnerGenero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#94A3B8"
                android:textColor="#334155"
                android:layout_marginBottom="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Instrumentos del proyecto"
                android:textColor="#334155"
                android:textSize="18sp" />

            <Spinner
                android:id="@+id/spinnerInstrumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#94A3B8"
                android:textColor="#334155"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnAgregarInstrumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#60A5FA"
                android:textColor="#FFFFFF"
                android:text="+ Agregar instrumento" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Instrumentos seleccionados:"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/contenedorInstrumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Tonalidad"
                android:textColor="#334155"
                android:textSize="18sp" />

            <Spinner
                android:id="@+id/spinnerTonalidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#94A3B8"
                android:textColor="#334155"
                android:layout_marginBottom="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Tempo (BPM)"
                android:textColor="#334155"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtTempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:hint="Ejemplo: 120"
                android:backgroundTint="#94A3B8"
                android:textColor="#334155"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Idea musical"
                android:textColor="#334155"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtIdea"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:gravity="top"
                android:hint="Describí tu idea musical"
                android:backgroundTint="#94A3B8"
                android:textColor="#334155"
                android:inputType="textMultiLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLimpiar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#94A3B8"
                    android:textColor="#FFFFFF"
                    android:text="Limpiar" />

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"
                    android:text="Crear proyecto" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>