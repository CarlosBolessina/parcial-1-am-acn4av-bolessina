<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background_content"
            android:padding="@dimen/padding_screen">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_xlarge"
                android:gravity="center"
                android:text="@string/titulo_principal"
                android:textSize="@dimen/text_size_title"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgMusica"
                android:layout_width="match_parent"
                android:layout_height="@dimen/image_height"
                android:layout_marginBottom="@dimen/margin_medium"
                android:scaleType="centerCrop"
                android:src="@drawable/musica"
                android:contentDescription="@string/descripcion_imagen_musica" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_section"
                android:text="@string/subtitulo_nuevo_proyecto"
                android:textSize="@dimen/text_size_subtitle"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_tiny"
                android:text="@string/label_nombre"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_label" />

            <EditText
                android:id="@+id/edtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_section"
                android:backgroundTint="@color/border"
                android:textColor="@color/text_secondary"
                android:hint="@string/hint_nombre" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/label_genero"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_label" />

            <Spinner
                android:id="@+id/spinnerGenero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/border"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/margin_section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/label_instrumentos"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_label" />

            <Spinner
                android:id="@+id/spinnerInstrumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/border"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/margin_large" />

            <Button
                android:id="@+id/btnAgregarInstrumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:backgroundTint="@color/button_add"
                android:textColor="@color/text_on_button"
                android:text="@string/boton_agregar_instrumento" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/label_instrumentos_seleccionados"
                android:textSize="@dimen/text_size_label" />

            <LinearLayout
                android:id="@+id/contenedorInstrumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/label_tonalidad"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_label" />

            <Spinner
                android:id="@+id/spinnerTonalidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/border"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/margin_section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/hint_tempo"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_label" />

            <EditText
                android:id="@+id/edtTempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_section"
                android:hint="@string/label_tempo"
                android:backgroundTint="@color/border"
                android:textColor="@color/text_secondary"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:text="@string/label_idea"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_label" />

            <EditText
                android:id="@+id/edtIdea"
                android:layout_width="match_parent"
                android:layout_height="@dimen/idea_height"
                android:layout_marginBottom="@dimen/margin_medium"
                android:gravity="top"
                android:hint="@string/hint_idea"
                android:backgroundTint="@color/border"
                android:textColor="@color/text_secondary"
                android:inputType="textMultiLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLimpiar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/border"
                    android:textColor="@color/text_on_button"
                    android:text="@string/boton_limpiar" />

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:backgroundTint="@color/button_primary"
                    android:textColor="@color/text_on_button"
                    android:text="@string/boton_crear" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>